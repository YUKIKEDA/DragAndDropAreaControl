<Window
    x:Class="DragAndDropAreaControl.Example.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:DragAndDropAreaControl;assembly=DragAndDropAreaControl"
    xmlns:local="clr-namespace:DragAndDropAreaControl.Example"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="DragAndDropAreaControl Example"
    Width="900"
    Height="700"
    mc:Ignorable="d">
    <Grid Background="#FFEFEFEF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  タイトル  -->
        <TextBlock
            Grid.Row="0"
            Margin="16"
            FontSize="20"
            FontWeight="Bold"
            Text="DragAndDropAreaControl サンプル" />

        <!--  中央に DragAndDropArea を配置して見た目を確認できるようにする  -->
        <dd:DragAndDropArea
            Grid.Row="1"
            Margin="32"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            AfterDropColor="#4000AAFF"
            AllowFile="True"
            AllowFolder="True"
            AllowedExtensions=".png"
            DragOverlayColor="#4000FF00"
            FileDropIcon="📄"
            FileDropText="ファイルを選択してください"
            FolderDropIcon="📁"
            FolderDropText="フォルダを選択してください"
            HeaderText="ヘッドラインテキスト" />
    </Grid>
</Window>
