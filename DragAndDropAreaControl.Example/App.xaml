    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:DragAndDropAreaControl.Example"
    StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="StlIconResources.xaml" />
                    <ResourceDictionary Source="NasIconResources.xaml" />
                    <ResourceDictionary Source="StlIconResourcesV2.xaml" />
                    <ResourceDictionary Source="NasIconResourcesV2.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
