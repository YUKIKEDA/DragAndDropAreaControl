<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  NASテキスト背景のGeometry（STLと同じサイズ）  -->
    <RectangleGeometry x:Key="NasBackgroundGeometry" Rect="-2,398,1000,600" />

    <!--  完全なNASアイコン（色指定可能版）  -->
    <ControlTemplate x:Key="NasIconTemplate">
        <Viewbox>
            <Canvas Width="1260" Height="1310">
                <!--  文書アイコン（StlDocumentGeometryを再利用）  -->
                <Path Data="{StaticResource StlDocumentGeometry}" Fill="{TemplateBinding Control.Foreground}" />

                <!--  NASテキストの背景  -->
                <Path Data="{StaticResource NasBackgroundGeometry}" Fill="{TemplateBinding Control.Background}" />

                <!--  NASテキスト - 簡易版（TextBlockを使用）  -->
                <TextBlock
                    Canvas.Left="88"
                    Canvas.Top="410"
                    FontFamily="Segoe UI"
                    FontSize="370"
                    FontWeight="Bold"
                    Foreground="{TemplateBinding Control.BorderBrush}"
                    Text="NAS" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

</ResourceDictionary>

