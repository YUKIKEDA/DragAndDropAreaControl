            <TranslateTransform X="111" Y="462" />
        </PathGeometry.Transform>
    </PathGeometry>

    <!--  STLテキストのGeometry (T) - SVGのフォント定義から  -->
    <PathGeometry x:Key="StlTextTGeometryV2" Figures="M 1171,1171 L 762,1171 762,0 438,0 438,1171 31,1171 31,1434 1171,1434 1171,1171 Z">
        <PathGeometry.Transform>
            <TranslateTransform X="433" Y="462" />
        </PathGeometry.Transform>
    </PathGeometry>

    <!--  STLテキストのGeometry (L) - SVGのフォント定義から  -->
    <PathGeometry x:Key="StlTextLGeometryV2" Figures="M 1018,0 L 164,0 164,1434 487,1434 487,262 1018,262 1018,0 Z">
        <PathGeometry.Transform>
            <TranslateTransform X="713" Y="462" />
        </PathGeometry.Transform>
    </PathGeometry>

    <!--  完全なSTLアイコン（色指定可能版、SVGベース）  -->
    <ControlTemplate x:Key="StlIconTemplateV2">
        <Viewbox>
            <Canvas Width="1440" Height="1190">
                <!--  文書アイコン  -->
                <Path Data="{StaticResource StlDocumentGeometryV2}" Fill="{TemplateBinding Control.Foreground}" />

                <!--  STLテキストの背景  -->
                <Path Data="{StaticResource StlBackgroundGeometryV2}" 
                      Fill="{TemplateBinding Control.Background}" 
                      Stroke="{TemplateBinding Control.BorderBrush}" 
                      StrokeThickness="18" 
                      StrokeLineJoin="Round" />

                <!--  STLテキスト - 簡易版（TextBlockを使用）  -->
                <TextBlock
                    Canvas.Left="111"
                    Canvas.Top="462"
                    FontFamily="Segoe UI"
                    FontSize="494"
                    FontWeight="Bold"
                    Foreground="{TemplateBinding Control.BorderBrush}"
                    Text="STL" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

</ResourceDictionary>

