<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  文書アイコンのGeometry（SVGから変換）  -->
    <PathGeometry x:Key="StlDocumentGeometryV2" Figures="M 834,172 L 986,33 C 1000,21 1016,13 1035,13 L 1377,13 C 1413,13 1455,43 1455,93 L 1455,172 834,172 Z M 133,1203 L 133,309 C 133,265 173,231 211,231 L 1455,231 1455,1203 133,1203 Z" />

    <!--  STLテキスト背景のGeometry（SVGから変換）  -->
