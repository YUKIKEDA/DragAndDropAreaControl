    <!--  完全なSTLアイコン（色指定可能版）  -->
    <ControlTemplate x:Key="StlIconTemplate">
        <Viewbox>
            <Canvas Width="1260" Height="1310">
                <!--  文書アイコン  -->
                <Path Data="{StaticResource StlDocumentGeometry}" Fill="{TemplateBinding Control.Foreground}" />

                <!--  STLテキストの背景  -->
                <Path Data="{StaticResource StlBackgroundGeometry}" Fill="{TemplateBinding Control.Background}" />

                <!--  STLテキスト - 簡易版（TextBlockを使用）  -->
                <TextBlock
                    Canvas.Left="88"
                    Canvas.Top="410"
                    FontFamily="Segoe UI"
                    FontSize="370"
                    FontWeight="Bold"
                    Foreground="{TemplateBinding Control.BorderBrush}"
                    Text="STL" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

</ResourceDictionary>

