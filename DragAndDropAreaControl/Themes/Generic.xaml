<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:DragAndDropAreaControl"
    xmlns:icon="clr-namespace:IconButtonControl;assembly=IconButtonControl">
    <Style TargetType="{x:Type local:DragAndDropArea}">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#FFCCCCCC" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:DragAndDropArea}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <!-- メインレイアウト -->
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- ヘッダー -->
                                <TextBlock
                                    Grid.Row="0"
                                    Margin="0,0,0,12"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="Black"
                                    Text="{TemplateBinding HeaderText}" />

                                <!-- ファイル／フォルダ選択ボタン -->
                                <Grid Grid.Row="1" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <icon:IconButton
                                        x:Name="PART_FileButton"
                                        Grid.Column="0"
                                        Margin="0,0,8,0"
                                        Icon="{TemplateBinding FileDropIcon}"
                                        Text="{TemplateBinding FileDropText}" />

                                    <icon:IconButton
                                        x:Name="PART_FolderButton"
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Icon="{TemplateBinding FolderDropIcon}"
                                        Text="{TemplateBinding FolderDropText}" />
                                </Grid>

                                <!-- ドロップされたファイル表示＋削除ボタン -->
                                <Grid Grid.Row="2" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Grid.Column="0"
                                        Background="#FFF9F9F9"
                                        BorderBrush="#FFDDDDDD"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8">
                                        <!-- TODO: 複数ファイル対応は次ステップで ItemsControl に変更 -->
                                        <TextBlock
                                            FontSize="12"
                                            Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=DroppedFiles[0], FallbackValue=ファイルをまだ選択していません}" />
                                    </Border>

                                    <icon:IconButton
                                        x:Name="PART_ClearButton"
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Width="80"
                                        Icon="×"
                                        Text="" />
                                </Grid>

                                <!-- エラーメッセージ -->
                                <TextBlock
                                    Grid.Row="3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#FFDD5555"
                                    Text="{TemplateBinding ErrorMessage}" />
                            </Grid>

                            <!-- オーバーレイレイヤー：ドラッグオーバー／ドロップ後／エラー（視覚のみ／ヒットテスト無効） -->
                            <Border
                                x:Name="DragOverlay"
                                Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=DragOverlayColor}"
                                Opacity="0"
                                Visibility="Collapsed"
                                IsHitTestVisible="False" />
                            <Border
                                x:Name="AfterDropOverlay"
                                Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=AfterDropColor}"
                                Opacity="0"
                                Visibility="Collapsed"
                                IsHitTestVisible="False" />
                            <Border
                                x:Name="ErrorOverlay"
                                Background="#14FF0000"
                                Opacity="0"
                                Visibility="Collapsed"
                                IsHitTestVisible="False" />

                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                                <!-- ドラッグオーバー中 -->
                                <Trigger Property="IsDragOver" Value="True">
                                    <Setter TargetName="DragOverlay" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="DragOverlay" Property="Opacity" Value="1" />
                                    <Setter TargetName="AfterDropOverlay" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="ErrorOverlay" Property="Visibility" Value="Collapsed" />
                                </Trigger>

                                <!-- ドロップ完了 -->
                                <Trigger Property="IsDropped" Value="True">
                                    <Setter TargetName="AfterDropOverlay" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="AfterDropOverlay" Property="Opacity" Value="1" />
                                    <Setter TargetName="DragOverlay" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="ErrorOverlay" Property="Visibility" Value="Collapsed" />
                                </Trigger>

                                <!-- エラー状態 -->
                                <Trigger Property="HasError" Value="True">
                                    <Setter TargetName="ErrorOverlay" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="ErrorOverlay" Property="Opacity" Value="1" />
                                    <Setter TargetName="DragOverlay" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="AfterDropOverlay" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
