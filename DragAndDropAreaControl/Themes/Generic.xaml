<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icon="clr-namespace:IconButtonControl;assembly=IconButtonControl"
    xmlns:local="clr-namespace:DragAndDropAreaControl">

    <!--  ベクターアイコン定義  -->
    <Geometry x:Key="FileIconGeometry">M4,2 L20,2 L20,22 L4,22 Z</Geometry>
    <Geometry x:Key="FolderIconGeometry">M4,8 L10,8 L12,4 L20,4 L20,22 L4,22 Z</Geometry>
    <Geometry x:Key="ClearIconGeometry">M6,6 L18,18 M18,6 L6,18</Geometry>
    <Style TargetType="{x:Type local:DragAndDropArea}">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#FFCCCCCC" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:DragAndDropArea}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <!--  メインレイアウト  -->
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!--  ヘッダー  -->
                                <TextBlock
                                    Grid.Row="0"
                                    Margin="0,0,0,12"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="Black"
                                    Text="{TemplateBinding HeaderText}" />

                                <!--  ファイル／フォルダ選択ボタン  -->
                                <Grid Grid.Row="1" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- IconButton.Content に FileDropIcon を渡し、IconButton 側の ContentPresenter で表示 -->
                                    <icon:IconButton
                                        x:Name="PART_FileButton"
                                        Grid.Column="0"
                                        Margin="0,0,8,0"
                                        Text="{TemplateBinding FileDropText}"
                                        Content="{TemplateBinding FileDropIcon}" />

                                    <!-- 同様に FolderDropIcon を渡す -->
                                    <icon:IconButton
                                        x:Name="PART_FolderButton"
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Text="{TemplateBinding FolderDropText}"
                                        Content="{TemplateBinding FolderDropIcon}" />
                                </Grid>

                                <!--  ドロップされたファイル表示＋削除ボタン（1ファイル＝1アイテム）  -->
                                <ItemsControl
                                    x:Name="PART_FileList"
                                    Grid.Row="2"
                                    Margin="0"
                                    ItemsSource="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=DroppedFiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border
                                                    Grid.Column="0"
                                                    Padding="8,2,8,0"
                                                    Background="#FFF9F9F9"
                                                    BorderBrush="#FFDDDDDD"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Text="{Binding}" />
                                                </Border>

                                                <icon:IconButton
                                                    Grid.Column="1"
                                                    Width="40"
                                                    Margin="8,0,0,0"
                                                    Padding="8,2,8,0"
                                                    IconSize="12"
                                                    Text="">
                                                    <Path
                                                        Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=icon:IconButton}}"
                                                        Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=icon:IconButton}}"
                                                        Stretch="Uniform"
                                                        Stroke="Black"
                                                        StrokeThickness="2"
                                                        Data="{StaticResource ClearIconGeometry}" />
                                                </icon:IconButton>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    <!-- ドロップされていない場合のプレースホルダ -->
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ItemsControl">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="12"
                                                            Text="ファイルをまだ選択していません" />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="HasItems" Value="True">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ItemsControl">
                                                                <ItemsPresenter />
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                </ItemsControl>

                                <!--  エラーメッセージ  -->
                                <TextBlock
                                    Grid.Row="3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#FFDD5555"
                                    Text="{TemplateBinding ErrorMessage}" />
                            </Grid>

                            <!--  オーバーレイレイヤー：ドラッグオーバー／ドロップ後／エラー（視覚のみ／ヒットテスト無効）  -->
                            <Border
                                x:Name="DragOverlay"
                                Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=DragOverlayColor}"
                                IsHitTestVisible="False"
                                Opacity="0"
                                Visibility="Collapsed" />
                            <Border
                                x:Name="AfterDropOverlay"
                                Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=AfterDropColor}"
                                IsHitTestVisible="False"
                                Opacity="0"
                                Visibility="Collapsed" />
                            <Border
                                x:Name="ErrorOverlay"
                                Background="#14FF0000"
                                IsHitTestVisible="False"
                                Opacity="0"
                                Visibility="Collapsed" />

                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!--  ドラッグオーバー中  -->
                        <Trigger Property="IsDragOver" Value="True">
                            <Setter TargetName="DragOverlay" Property="Visibility" Value="Visible" />
                            <Setter TargetName="DragOverlay" Property="Opacity" Value="1" />
                            <Setter TargetName="AfterDropOverlay" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ErrorOverlay" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!--  ドロップ完了  -->
                        <Trigger Property="IsDropped" Value="True">
                            <Setter TargetName="AfterDropOverlay" Property="Visibility" Value="Visible" />
                            <Setter TargetName="AfterDropOverlay" Property="Opacity" Value="1" />
                            <Setter TargetName="DragOverlay" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ErrorOverlay" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!--  エラー状態  -->
                        <Trigger Property="HasError" Value="True">
                            <Setter TargetName="ErrorOverlay" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ErrorOverlay" Property="Opacity" Value="1" />
                            <Setter TargetName="DragOverlay" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="AfterDropOverlay" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
